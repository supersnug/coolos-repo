# Maintainer: supersnug
# shellcheck shell=bash disable=SC2034,SC2154

pkgname=cachyos-calamares-next
pkgver=3.4.2.r0.g0000000
pkgrel=1
_cpu_target=${COOLOS_CPU_TARGET:-x86-64}
case $_cpu_target in
  x86-64) ;;
  x86-64-v3) pkgrel+=.1 ;;
  x86-64-v4) pkgrel+=.2 ;;
  znver4) pkgrel+=.3 ;;
  *) printf 'Unsupported CPU target: %s\n' "$_cpu_target" >&2; exit 1 ;;
esac
pkgdesc='CoolOS development build of the CachyOS Calamares installer'
arch=('x86_64')
license=('GPL-3.0-or-later')
url='https://github.com/supersnug/CoolOS-Installer'
conflicts=('calamares')
provides=('calamares')
depends=(
  boost-libs
  ckbcomp
  cryptsetup
  dmidecode
  gptfdisk
  hwinfo
  kconfig
  kcoreaddons
  kcrash
  ki18n
  kparts
  kpmcore
  kservice
  kwidgetsaddons
  libpwquality
  mkinitcpio-openswap
  networkmanager
  polkit-qt6
  python
  python-toml
  qt6-declarative
  qt6-imageformats
  qt6-svg
  rsync
  solid
  squashfs-tools
  upower
  yaml-cpp
)
makedepends=(
  boost
  cmake
  doxygen
  extra-cmake-modules
  git
  ninja
  python-jsonschema
  python-pyaml
  python-unidecode
  qt6-tools
)
_commit=feea3370ff7b004b8b737e85c21902ba7c643384
source=("calamares::git+https://github.com/supersnug/CoolOS-Installer.git#commit=${_commit}")
sha256sums=('SKIP')
options=('!emptydirs')

pkgver() {
  cd calamares || return
  printf '3.4.2.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd calamares || return

  python -m unittest discover -s tests -p test_coolos_repositories.py

  local tune=generic
  [[ $_cpu_target != znver4 ]] || tune=znver4
  export CFLAGS+=" -march=$_cpu_target -mtune=$tune"
  export CXXFLAGS+=" -fPIC -march=$_cpu_target -mtune=$tune"

  cmake -S . -B build \
    -GNinja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_APPSTREAM=OFF \
    -DWITH_PYBIND11=OFF \
    -DWITH_QT6=ON \
    -DSKIP_MODULES='dracut dracutlukscfg dummycpp dummyprocess dummypython dummypythonqt finishedq keyboardq license localeq notesqml oemid openrcdmcryptcfg packagechooserq fsresizer rawfs mkinitfs contextualprocess interactiveterminal plasmalnf services-openrc summaryq tracking usersq webview welcomeq'

  cmake --build build
}

package() {
  cd calamares/build || return
  DESTDIR="${pkgdir}" cmake --build . --target install

  install -Dm644 ../settings_offline.conf "${pkgdir}/usr/share/calamares/settings_offline.conf"
  install -Dm644 ../settings_online.conf "${pkgdir}/usr/share/calamares/settings_online.conf"
  install -Dm644 ../settings_online.conf "${pkgdir}/usr/share/calamares/settings.conf"
  install -dm755 "${pkgdir}/etc/calamares/modules"
  cp -rf ../src/modules/*/*.conf "${pkgdir}/etc/calamares/modules"
  cp -rf ../src/scripts "${pkgdir}/etc/calamares"
  cp -rf ../src/images "${pkgdir}/etc/calamares"
  cp ../src/modules/netinstall/netinstall.yaml "${pkgdir}/etc/calamares/modules/netinstall.yaml"

  rm -rf "${pkgdir}/usr/share/applications"
}
