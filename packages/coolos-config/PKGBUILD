package_coolos-config() {
  pkgdesc='Upgradeable CoolOS system and service policy'
  depends=('systemd')
  backup=('etc/docker/daemon.json')

  install -Dm644 daemon.json "$pkgdir/etc/docker/daemon.json"
  install -Dm644 bpftune-support.conf \
    "$pkgdir/usr/lib/systemd/system/bpftune.service.d/10-coolos-support.conf"
  install -Dm644 50-coolos.preset \
    "$pkgdir/usr/lib/systemd/system-preset/50-coolos.preset"
  install -Dm644 50-coolos-user.preset \
    "$pkgdir/usr/lib/systemd/user-preset/50-coolos.preset"
}

package_coolos-niri-settings() {
  pkgdesc='Generic CoolOS Niri and Noctalia settings'
  depends=(
    'coolos-config'
    'adw-gtk-theme'
    'cachyos-alacritty-config'
    'capitaine-cursors'
    'firefox'
    'gnome-keyring'
    'nautilus'
    'niri'
    'noctalia'
    'noto-fonts'
    'noto-fonts-emoji'
    'uwsm'
    'wl-clipboard'
    'xdg-desktop-portal-gnome'
    'xdg-desktop-portal-gtk'
    'xwayland-satellite'
  )
  provides=('cachyos-desktop-settings')
  conflicts=(
    'cachyos-desktop-settings'
    'cachyos-niri-noctalia'
  )
  replaces=('cachyos-niri-noctalia')

  local niri_dir="$pkgdir/etc/skel/.config/niri"
  install -Dm644 config.kdl "$niri_dir/config.kdl"
  install -Dm644 animation.kdl "$niri_dir/cfg/animation.kdl"
  install -Dm644 autostart.kdl "$niri_dir/cfg/autostart.kdl"
  install -Dm644 input.kdl "$niri_dir/cfg/input.kdl"
  install -Dm644 keybinds.kdl "$niri_dir/cfg/keybinds.kdl"
  install -Dm644 layout.kdl "$niri_dir/cfg/layout.kdl"
  install -Dm644 misc.kdl "$niri_dir/cfg/misc.kdl"
  install -Dm644 rules.kdl "$niri_dir/cfg/rules.kdl"
  install -Dm644 noctalia.toml \
    "$pkgdir/etc/skel/.config/noctalia/config.toml"
}
