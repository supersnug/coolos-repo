# Maintainer: supersnug
# Based on the AUR opencode-desktop package maintained by Byeonghoon Yoo.
# shellcheck shell=bash disable=SC2034,SC2154

pkgname=opencode-desktop
pkgver=2.0.31
pkgrel=1
_cpu_target=${COOLOS_CPU_TARGET:-x86-64}
case $_cpu_target in
  x86-64) ;;
  x86-64-v3) pkgrel+=.1 ;;
  x86-64-v4) pkgrel+=.2 ;;
  znver4) pkgrel+=.3 ;;
  *) printf 'Unsupported CPU target: %s\n' "$_cpu_target" >&2; exit 1 ;;
esac
pkgdesc='OpenCode desktop app built from source for system Electron'
arch=('x86_64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
depends=(
  'electron44'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'opencode=2.0.31'
)
makedepends=(
  'bun'
  'git'
  'libxcrypt-compat'
  'node-gyp'
)
optdepends=(
  'nodejs: needed only by npm CLI helpers bundled in node_modules'
)
replaces=('opencode-desktop-electron')
conflicts=(
  'opencode-desktop-bin'
  'opencode-desktop-electron'
  'opencode-desktop-electron-bin'
)
options=('!strip' '!debug')
_commit=22728d67461260d56bb9796b9b8f36e1de47202e
source=(
  "$pkgname::git+https://github.com/anomalyco/opencode.git#commit=${_commit}"
  "$pkgname.sh"
  'enable-pacman-target.patch'
  'use-system-cli.patch'
)
sha256sums=('c80dfdcca71d2eb819bee9d80c3b2ea71852e81e96a56e33e163f6d83440012c'
            '5474a17cc16bd58bc52117f8cc49c319e7c6861863873fbb8a86953794ba9ef1'
            'e92b69023a9d25f6a6809fa39583657e72cdd69a66a01b7392f22b6ae8f2de9e'
            '6dd92202e313b67979c25181c2e7b6c99a47f20f6858ac7d1d41b186609f823e')

prepare() {
  cd "$srcdir/$pkgname" || return

  patch -Np1 -i "$srcdir/enable-pacman-target.patch"
  patch -Np1 -i "$srcdir/use-system-cli.patch"

  # System Electron treats external application code as development code.
  # Patch before V2 minifies and splits the main process into hashed chunks.
  find packages/desktop/src/main -type f -name '*.ts' \
    -exec sed -i 's/app\.isPackaged/true/g' {} +
}

build() {
  cd "$srcdir/$pkgname" || return

  export OPENCODE_CHANNEL=prod
  export ELECTRON_BUILDER_CACHE="$srcdir/.cache/electron-builder"

  # Native addons must not inherit the build runner's CPU instruction set.
  local tune=generic
  [[ $_cpu_target != znver4 ]] || tune=znver4
  export CFLAGS+=" -march=$_cpu_target -mtune=$tune"
  export CXXFLAGS+=" -march=$_cpu_target -mtune=$tune"

  bun install
  bun run --cwd packages/desktop build

  find packages/desktop/out -type f \
    \( -name '*.js' -o -name '*.cjs' -o -name '*.mjs' \) \
    -exec sed -i "s|$srcdir/$pkgname|/usr/lib/$pkgname|g" {} +

  local sysver
  sysver=$(< /usr/lib/electron44/version)

  (cd packages/desktop && bun run package -- \
    --linux pacman \
    -c.asar=false \
    -c.electronDist=/usr/lib/electron44 \
    -c.electronVersion="$sysver" \
    --publish=never)
}

package() {
  local _bld="$srcdir/$pkgname/packages/desktop"

  install -d "$pkgdir/usr/lib/$pkgname"
  cp -a "$_bld/dist/linux-unpacked/resources/app/." "$pkgdir/usr/lib/$pkgname/"

  local _pj="$pkgdir/usr/lib/$pkgname/package.json"
  if grep -q '"desktopName"' "$_pj"; then
    sed -i "s|\"desktopName\":[[:space:]]*\"[^\"]*\"|\"desktopName\": \"$pkgname\"|" "$_pj"
  else
    sed -i "/\"name\":/a\\  \"desktopName\": \"$pkgname\"," "$_pj"
  fi
  grep -q "\"desktopName\": \"$pkgname\"" "$_pj" || {
    echo "ERROR: failed to set desktopName in $_pj" >&2
    return 1
  }

  find "$pkgdir/usr/lib/$pkgname" -name '*.musl.node' -delete
  find "$pkgdir/usr/lib/$pkgname" -depth -type d -name '*-musl*' -exec rm -rf {} +
  chmod -R go-w "$pkgdir/usr/lib/$pkgname"

  install -Dm755 "$srcdir/$pkgname.sh" "$pkgdir/usr/bin/$pkgname"

  local _eb="$srcdir/.eb-pacman"
  rm -rf "$_eb" && mkdir -p "$_eb"
  bsdtar -xf "$_bld"/dist/*.pacman -C "$_eb"

  local _ebname='ai.opencode.desktop'
  sed -e "s|^Exec=.*|Exec=$pkgname %U|" \
      -e "s|^Icon=.*|Icon=$pkgname|" \
      -e "s|^StartupWMClass=.*|StartupWMClass=$pkgname|" \
      "$_eb/usr/share/applications/$_ebname.desktop" |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop"

  local png size
  for png in "$_eb"/usr/share/icons/hicolor/*/apps/"$_ebname.png"; do
    size=$(basename "$(dirname "$(dirname "$png")")")
    install -Dm644 "$png" "$pkgdir/usr/share/icons/hicolor/$size/apps/$pkgname.png"
  done

  install -Dm644 "$srcdir/$pkgname/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
